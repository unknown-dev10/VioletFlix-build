# ─── VioletFlix Environment Variables ───────────────────────────────────────

# API Proxy (panel + streams + search)
PORT=3050
HOST=0.0.0.0
PANEL_TOKEN=violetkingdev10   # used for /panel and /api/panel/* routes

# TMDB (movie/TV metadata)
EXPO_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here

# Supabase (auth + push notifications)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# RapidAPI (sports highlights + live streams)
RAPIDAPI_KEY=your_rapidapi_key_here

# App public URL (for SEO / OG / canonical)
EXPO_PUBLIC_APP_URL=https://your-domain.com

# Static frontend server (serve-static.js)
# Frontend runs on 3000, API proxy on 3050
